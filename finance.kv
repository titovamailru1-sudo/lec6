#:kivy 2.3.0
#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp
#:import hex kivy.utils.get_color_from_hex
#:import NoTransition kivy.uix.screenmanager.NoTransition

<LeftLabel@Label>:
    color: hex("#18352C")
    font_size: sp(15)
    text_size: self.size
    halign: "left"
    valign: "middle"
    shorten: True
    shorten_from: "right"

<Caption@LeftLabel>:
    color: hex("#49665C")
    font_size: sp(13)

<Card@BoxLayout>:
    canvas.before:
        Color:
            rgba: hex("#FFFFFF")
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]

<Action@Button>:
    active: False
    background_normal: ""
    background_down: ""
    background_disabled_normal: ""
    background_color: 0, 0, 0, 0
    color: hex("#F5FFFA") if self.active else hex("#23463A")
    disabled_color: hex("#49665C")
    font_size: sp(14)
    bold: True
    size_hint_y: None
    height: dp(46)
    canvas.before:
        Color:
            rgba: hex("#136F59") if self.active else (hex("#E1EDE5") if self.state == "down" else hex("#E6EFE8"))
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(11)]

<Pill@Action>:
    height: dp(40)
    font_size: sp(13)

<Entry@TextInput>:
    size_hint_y: None
    height: dp(46)
    multiline: False
    font_size: sp(16)
    foreground_color: hex("#18352C")
    hint_text_color: hex("#49665C")
    cursor_color: hex("#136F59")
    background_color: 0, 0, 0, 0
    padding: [dp(12), dp(12), dp(12), dp(8)]
    canvas.before:
        Color:
            rgba: hex("#EDF4EF") if not self.focus else hex("#E2F2E9")
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]

<PickerItem@SpinnerOption>:
    height: dp(46)
    background_normal: ""
    background_down: ""
    background_color: hex("#234639")
    font_size: sp(15)

<Notice>:
    title_color: hex("#18352C")
    separator_color: hex("#DCE9E0")
    background: ""
    background_color: 1, 1, 1, 1
    size_hint: 0.91, None
    height: dp(226)
    BoxLayout:
        orientation: "vertical"
        padding: dp(14)
        spacing: dp(12)
        LeftLabel:
            text: root.message
            shorten: False
        BoxLayout:
            size_hint_y: None
            height: dp(46)
            spacing: dp(8)
            Action:
                active: False
                text: "Отмена" if root.action else "Закрыть"
                on_release: root.dismiss()
            Action:
                active: True
                text: root.action_label
                size_hint_x: 1 if root.action else None
                width: 0
                opacity: 1 if root.action else 0
                disabled: not root.action
                on_release: root.confirm()

<Editor>:
    title_color: hex("#18352C")
    separator_color: hex("#DCE9E0")
    background: ""
    background_color: 1, 1, 1, 1
    size_hint: 0.92, None
    height: dp(462)
    auto_dismiss: False
    BoxLayout:
        orientation: "vertical"
        padding: dp(14)
        spacing: dp(8)
        BoxLayout:
            size_hint_y: None
            height: dp(40)
            spacing: dp(8)
            Pill:
                active: root.kind == "expense"
                text: "Расход"
                on_release: root.choose_kind("expense")
            Pill:
                active: root.kind == "income"
                text: "Доход"
                on_release: root.choose_kind("income")
        Spinner:
            id: category_spinner
            text: root.category + "  ▾"
            values: app.categories[root.kind]
            option_cls: "PickerItem"
            size_hint_y: None
            height: dp(46)
            color: hex("#234639")
            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0
            canvas.before:
                Color:
                    rgba: hex("#E6EFE8")
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(10)]
            on_text: root.category = self.text if self.text in self.values else root.category
        Entry:
            id: note
            hint_text: "Описание"
        Entry:
            id: amount
            hint_text: "Сумма, ₽"
        BoxLayout:
            size_hint_y: None
            height: dp(46)
            spacing: dp(8)
            Caption:
                text: "Дата"
                size_hint_x: 0.28
            Entry:
                id: day
                hint_text: "ГГГГ-ММ-ДД"
        LeftLabel:
            text: root.error
            color: hex("#A43B31")
            font_size: sp(13)
            shorten: False
        BoxLayout:
            size_hint_y: None
            height: dp(46)
            spacing: dp(8)
            Action:
                active: False
                text: "Удалить" if root.record_id else "Отмена"
                on_release: app.delete_operation(root) if root.record_id else root.dismiss()
            Action:
                active: True
                text: "Сохранить"
                on_release: root.save()
        Action:
            active: False
            text: "Закрыть"
            height: dp(36) if root.record_id else 0
            opacity: 1 if root.record_id else 0
            disabled: not root.record_id
            on_release: root.dismiss()

<TransactionRow>:
    size_hint_y: None
    height: dp(63)
    padding: [dp(12), dp(7)]
    spacing: dp(10)
    canvas.before:
        Color:
            rgba: hex("#FFFFFF")
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
    Label:
        text: "+" if root.kind == "income" else "−"
        color: hex("#136F59") if root.kind == "income" else hex("#A43B31")
        bold: True
        font_size: sp(18)
        size_hint_x: None
        width: dp(33)
        canvas.before:
            Color:
                rgba: hex("#DDF1E6") if root.kind == "income" else hex("#F8E8E2")
            RoundedRectangle:
                pos: self.x, self.center_y - dp(16)
                size: dp(33), dp(33)
                radius: [dp(9)]
    BoxLayout:
        orientation: "vertical"
        LeftLabel:
            text: root.note
            bold: True
        Caption:
            text: root.metadata
            font_size: sp(12)
    LeftLabel:
        text: root.amount
        halign: "right"
        bold: True
        color: hex("#136F59") if root.kind == "income" else hex("#8D362A")
        size_hint_x: None
        width: dp(139)
        font_size: sp(14)
    Button:
        text: "›"
        font_size: sp(27)
        color: hex("#49665C")
        background_normal: ""
        background_down: ""
        background_color: 0, 0, 0, 0
        size_hint_x: None
        width: dp(30)
        on_release: app.open_editor(root.record_id)

<FinanceView>:
    orientation: "vertical"
    padding: [dp(18), dp(16), dp(18), dp(16)]
    spacing: dp(13)
    canvas.before:
        Color:
            rgba: hex("#F1F6F2")
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        size_hint_y: None
        height: dp(43)
        spacing: dp(10)
        Label:
            text: "₽"
            color: hex("#FFFFFF")
            size_hint_x: None
            width: dp(42)
            bold: True
            font_size: sp(23)
            canvas.before:
                Color:
                    rgba: hex("#136F59")
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(12)]
        LeftLabel:
            text: "Баланс"
            font_size: sp(27)
            bold: True
    BoxLayout:
        size_hint_y: None
        height: dp(40)
        spacing: dp(8)
        Pill:
            text: "Операции"
            active: root.section == "operations"
            on_release: app.open_section("operations")
        Pill:
            text: "Аналитика"
            active: root.section == "analytics"
            on_release: app.open_section("analytics")
        Pill:
            text: "Синхронизация"
            active: root.section == "sync"
            on_release: app.open_section("sync")
    ScreenManager:
        id: pages
        transition: NoTransition()
        Screen:
            name: "operations"
            BoxLayout:
                orientation: "vertical"
                spacing: dp(11)
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(115)
                    padding: [dp(16), dp(14)]
                    spacing: dp(3)
                    canvas.before:
                        Color:
                            rgba: hex("#164739")
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(17)]
                    Caption:
                        text: "Текущий баланс"
                        color: hex("#CFE9DB")
                        size_hint_y: None
                        height: dp(22)
                    LeftLabel:
                        text: root.balance
                        color: hex("#FFD8CB") if root.negative else hex("#FFFFFF")
                        bold: True
                        font_size: sp(34)
                BoxLayout:
                    size_hint_y: None
                    height: dp(66)
                    spacing: dp(9)
                    Card:
                        orientation: "vertical"
                        padding: [dp(12), dp(9)]
                        Caption:
                            text: "Доходы"
                        LeftLabel:
                            text: root.income
                            color: hex("#136F59")
                            bold: True
                            font_size: sp(17)
                    Card:
                        orientation: "vertical"
                        padding: [dp(12), dp(9)]
                        Caption:
                            text: "Расходы"
                        LeftLabel:
                            text: root.expense
                            color: hex("#8D362A")
                            bold: True
                            font_size: sp(17)
                BoxLayout:
                    size_hint_y: None
                    height: dp(36)
                    LeftLabel:
                        text: "Журнал операций"
                        font_size: sp(19)
                        bold: True
                    Pill:
                        text: "CSV"
                        active: False
                        disabled: not root.has_operations
                        size_hint_x: None
                        width: dp(68)
                        height: dp(36)
                        on_release: app.export_csv()
                BoxLayout:
                    size_hint_y: None
                    height: dp(34)
                    spacing: dp(6)
                    Pill:
                        text: "Все"
                        height: dp(34)
                        active: root.filter_mode == "all"
                        on_release: app.filter_operations("all")
                    Pill:
                        text: "Доходы"
                        height: dp(34)
                        active: root.filter_mode == "income"
                        on_release: app.filter_operations("income")
                    Pill:
                        text: "Расходы"
                        height: dp(34)
                        active: root.filter_mode == "expense"
                        on_release: app.filter_operations("expense")
                FloatLayout:
                    RecycleView:
                        id: operations_list
                        pos_hint: {"x": 0, "y": 0}
                        viewclass: "TransactionRow"
                        opacity: 0 if root.empty else 1
                        bar_width: dp(4)
                        RecycleBoxLayout:
                            orientation: "vertical"
                            spacing: dp(7)
                            default_size: None, dp(63)
                            default_size_hint: 1, None
                            size_hint_y: None
                            height: self.minimum_height
                    LeftLabel:
                        pos_hint: {"x": 0, "y": 0}
                        halign: "center"
                        text: "Нет операций по этому фильтру" if root.has_operations else "Добавьте первый доход или расход"
                        color: hex("#49665C")
                        opacity: 1 if root.empty else 0
                Action:
                    text: "+ Операция"
                    active: True
                    height: dp(52)
                    on_release: app.open_editor()
        Screen:
            name: "analytics"
            BoxLayout:
                orientation: "vertical"
                spacing: dp(12)
                BoxLayout:
                    size_hint_y: None
                    height: dp(42)
                    spacing: dp(8)
                    Pill:
                        text: "По категориям"
                        active: root.chart_mode == "category"
                        on_release: app.show_chart("category")
                    Pill:
                        text: "По месяцам"
                        active: root.chart_mode == "month"
                        on_release: app.show_chart("month")
                FloatLayout:
                    Card:
                        id: chart
                        pos_hint: {"x": 0, "y": 0}
                        padding: dp(8)
                    LeftLabel:
                        pos_hint: {"x": 0, "y": 0}
                        text: "Графики появятся после добавления операций"
                        halign: "center"
                        shorten: False
                        opacity: 0 if root.has_operations else 1
        Screen:
            name: "sync"
            ScrollView:
                do_scroll_x: False
                bar_width: dp(4)
                Card:
                    orientation: "vertical"
                    padding: dp(15)
                    spacing: dp(9)
                    size_hint_y: None
                    height: self.minimum_height
                    LeftLabel:
                        text: "Общий журнал"
                        bold: True
                        font_size: sp(21)
                        size_hint_y: None
                        height: dp(33)
                    Caption:
                        text: "Введите одинаковый адрес и токен на устройствах, чтобы обменяться операциями."
                        shorten: False
                        size_hint_y: None
                        height: dp(52)
                    Caption:
                        text: "Адрес сервера"
                        size_hint_y: None
                        height: dp(20)
                    Entry:
                        id: url
                        text: root.url
                        hint_text: "https://finance.example.org"
                        disabled: root.sync_busy
                    Caption:
                        text: "Токен доступа"
                        size_hint_y: None
                        height: dp(20)
                    Entry:
                        id: token
                        text: root.token
                        hint_text: "Токен сервера"
                        password: True
                        disabled: root.sync_busy
                    Action:
                        text: "Обмен данными…" if root.sync_busy else "Синхронизировать"
                        active: True
                        disabled: root.sync_busy
                        on_release: app.synchronize(url.text, token.text)
                    Caption:
                        text: root.sync_status
                        shorten: False
                        size_hint_y: None
                        height: dp(45)
